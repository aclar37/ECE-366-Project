module CLA(A, B, Cin, S, Cout);

  input [31:0] A, B;
  input Cin;

  output [31:0] S;
  output Cout;

  // P and G for each of the eight 4-bit blocks
  wire [7:0] P, G;

  // Three levels of block carry-lookahead logic
  wire [7:0] P1, G1;
  wire [7:0] P2, G2;
  wire [7:0] P3, G3;

  wire [7:0] T1, T2, T3;
  wire [7:0] TC;
  wire [8:0] C;

  assign C[0] = Cin;
  assign Cout = C[8];

  genvar i;

  generate
    // Compute P/G and the sum for each 4-bit block
    for (i = 0; i < 8; i = i + 1) begin: blocks

      four_bit_PG pg(
        .A(A[4*i + 3 : 4*i]),
        .B(B[4*i + 3 : 4*i]),
        .P(P[i]),
        .G(G[i])
      );

      four_bit_RCA rca(
        .A(A[4*i + 3 : 4*i]),
        .B(B[4*i + 3 : 4*i]),
        .Cin(C[i]),
        .S(S[4*i + 3 : 4*i]),
        .Cout()
      );

    end

    // Level 1: combine neighboring blocks
    for (i = 0; i < 8; i = i + 1) begin: level1

      if (i >= 1) begin
        and (P1[i], P[i], P[i-1]);
        and (T1[i], P[i], G[i-1]);
        or  (G1[i], G[i], T1[i]);
      end
      else begin
        assign P1[i] = P[i];
        assign G1[i] = G[i];
        assign T1[i] = 1'b0;
      end

    end

    // Level 2: combine groups separated by two blocks
    for (i = 0; i < 8; i = i + 1) begin: level2

      if (i >= 2) begin
        and (P2[i], P1[i], P1[i-2]);
        and (T2[i], P1[i], G1[i-2]);
        or  (G2[i], G1[i], T2[i]);
      end
      else begin
        assign P2[i] = P1[i];
        assign G2[i] = G1[i];
        assign T2[i] = 1'b0;
      end

    end

    // Level 3: combine groups separated by four blocks
    for (i = 0; i < 8; i = i + 1) begin: level3

      if (i >= 4) begin
        and (P3[i], P2[i], P2[i-4]);
        and (T3[i], P2[i], G2[i-4]);
        or  (G3[i], G2[i], T3[i]);
      end
      else begin
        assign P3[i] = P2[i];
        assign G3[i] = G2[i];
        assign T3[i] = 1'b0;
      end

    end

    // Calculate every block carry using the original Cin
    for (i = 0; i < 8; i = i + 1) begin: carries

      and (TC[i], P3[i], Cin);
      or  (C[i+1], G3[i], TC[i]);

    end
  endgenerate

endmodule
