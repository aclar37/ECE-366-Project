// Structural 1-bit full adder from Problem 1(b)
module one_bit_full_adder(A, B, Cin, S, Cout);

    input A, B, Cin;
    output S, Cout;

    wire sum1;
    wire carry1;
    wire carry2;

    xor g1(sum1, A, B);
    and g2(carry1, A, B);

    xor g3(S, sum1, Cin);
    and g4(carry2, sum1, Cin);

    or g5(Cout, carry1, carry2);

endmodule

module four_bit_RCA_RCS(A, B, Cin, S, Cout);

    input [3:0] A, B;
    input Cin;
    output [3:0] S;
    output Cout;

    wire [3:0] modifiedB;
    wire c1, c2, c3;

    xor x0(modifiedB[0], B[0], Cin);
    xor x1(modifiedB[1], B[1], Cin);
    xor x2(modifiedB[2], B[2], Cin);
    xor x3(modifiedB[3], B[3], Cin);

    one_bit_full_adder fa0(
        A[0], modifiedB[0], Cin, S[0], c1
    );

    one_bit_full_adder fa1(
        A[1], modifiedB[1], c1, S[1], c2
    );

    one_bit_full_adder fa2(
        A[2], modifiedB[2], c2, S[2], c3
    );

    one_bit_full_adder fa3(
        A[3], modifiedB[3], c3, S[3], Cout
    );

endmodule
