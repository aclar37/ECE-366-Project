module PPA(A, B, Cin, S, Cout);

input [15:0] A, B;
input Cin;
output [15:0] S;
output Cout;

// Pre-computation block
wire [15:0] P;
wire [15:0] G;

assign P = A ^ B;
assign G = A & B;

wire Pm1;
assign Pm1 = 1'b0;

// Prefix block wires
wire p14_13, g14_13, t14_13;
wire p12_11, g12_11, t12_11;
wire p10_9,  g10_9,  t10_9;
wire p8_7,   g8_7,   t8_7;
wire p6_5,   g6_5,   t6_5;
wire p4_3,   g4_3,   t4_3;
wire p2_1,   g2_1,   t2_1;
wire p0_m1,  g0_m1,  t0_m1;

wire p14_11, g14_11, t14_11;
wire p13_11, g13_11, t13_11;
wire p10_7,  g10_7,  t10_7;
wire p9_7,   g9_7,   t9_7;
wire p6_3,   g6_3,   t6_3;
wire p5_3,   g5_3,   t5_3;
wire p2_m1,  g2_m1,  t2_m1;
wire p1_m1,  g1_m1,  t1_m1;

wire p14_7,  g14_7,  t14_7;
wire p13_7,  g13_7,  t13_7;
wire p12_7,  g12_7,  t12_7;
wire p11_7,  g11_7,  t11_7;
wire p6_m1,  g6_m1,  t6_m1;
wire p5_m1,  g5_m1,  t5_m1;
wire p4_m1,  g4_m1,  t4_m1;
wire p3_m1,  g3_m1,  t3_m1;

wire p14_m1, g14_m1, t14_m1;
wire p13_m1, g13_m1, t13_m1;
wire p12_m1, g12_m1, t12_m1;
wire p11_m1, g11_m1, t11_m1;
wire p10_m1, g10_m1, t10_m1;
wire p9_m1,  g9_m1,  t9_m1;
wire p8_m1,  g8_m1,  t8_m1;
wire p7_m1,  g7_m1,  t7_m1;

// First prefix level
and AND_P14_13(p14_13, P[14], P[13]);
and AND_T14_13(t14_13, P[14], G[13]);
or  OR_G14_13(g14_13, G[14], t14_13);

and AND_P12_11(p12_11, P[12], P[11]);
and AND_T12_11(t12_11, P[12], G[11]);
or  OR_G12_11(g12_11, G[12], t12_11);

and AND_P10_9(p10_9, P[10], P[9]);
and AND_T10_9(t10_9, P[10], G[9]);
or  OR_G10_9(g10_9, G[10], t10_9);

and AND_P8_7(p8_7, P[8], P[7]);
and AND_T8_7(t8_7, P[8], G[7]);
or  OR_G8_7(g8_7, G[8], t8_7);

and AND_P6_5(p6_5, P[6], P[5]);
and AND_T6_5(t6_5, P[6], G[5]);
or  OR_G6_5(g6_5, G[6], t6_5);

and AND_P4_3(p4_3, P[4], P[3]);
and AND_T4_3(t4_3, P[4], G[3]);
or  OR_G4_3(g4_3, G[4], t4_3);

and AND_P2_1(p2_1, P[2], P[1]);
and AND_T2_1(t2_1, P[2], G[1]);
or  OR_G2_1(g2_1, G[2], t2_1);

and AND_P0_m1(p0_m1, P[0], Pm1);
and AND_T0_m1(t0_m1, P[0], Cin);
or  OR_G0_m1(g0_m1, G[0], t0_m1);

// Second prefix level
and AND_P14_11(p14_11, p14_13, p12_11);
and AND_T14_11(t14_11, p14_13, g12_11);
or  OR_G14_11(g14_11, g14_13, t14_11);

and AND_P13_11(p13_11, P[13], p12_11);
and AND_T13_11(t13_11, P[13], g12_11);
or  OR_G13_11(g13_11, G[13], t13_11);

and AND_P10_7(p10_7, p10_9, p8_7);
and AND_T10_7(t10_7, p10_9, g8_7);
or  OR_G10_7(g10_7, g10_9, t10_7);

and AND_P9_7(p9_7, P[9], p8_7);
and AND_T9_7(t9_7, P[9], g8_7);
or  OR_G9_7(g9_7, G[9], t9_7);

and AND_P6_3(p6_3, p6_5, p4_3);
and AND_T6_3(t6_3, p6_5, g4_3);
or  OR_G6_3(g6_3, g6_5, t6_3);

and AND_P5_3(p5_3, P[5], p4_3);
and AND_T5_3(t5_3, P[5], g4_3);
or  OR_G5_3(g5_3, G[5], t5_3);

and AND_P2_m1(p2_m1, p2_1, p0_m1);
and AND_T2_m1(t2_m1, p2_1, g0_m1);
or  OR_G2_m1(g2_m1, g2_1, t2_m1);

and AND_P1_m1(p1_m1, P[1], p0_m1);
and AND_T1_m1(t1_m1, P[1], g0_m1);
or  OR_G1_m1(g1_m1, G[1], t1_m1);

// Third prefix level
and AND_P14_7(p14_7, p14_11, p10_7);
and AND_T14_7(t14_7, p14_11, g10_7);
or  OR_G14_7(g14_7, g14_11, t14_7);

and AND_P13_7(p13_7, p13_11, p10_7);
and AND_T13_7(t13_7, p13_11, g10_7);
or  OR_G13_7(g13_7, g13_11, t13_7);

and AND_P12_7(p12_7, p12_11, p10_7);
and AND_T12_7(t12_7, p12_11, g10_7);
or  OR_G12_7(g12_7, g12_11, t12_7);

and AND_P11_7(p11_7, P[11], p10_7);
and AND_T11_7(t11_7, P[11], g10_7);
or  OR_G11_7(g11_7, G[11], t11_7);

and AND_P6_m1(p6_m1, p6_3, p2_m1);
and AND_T6_m1(t6_m1, p6_3, g2_m1);
or  OR_G6_m1(g6_m1, g6_3, t6_m1);

and AND_P5_m1(p5_m1, p5_3, p2_m1);
and AND_T5_m1(t5_m1, p5_3, g2_m1);
or  OR_G5_m1(g5_m1, g5_3, t5_m1);

and AND_P4_m1(p4_m1, P[4], p2_m1);
and AND_T4_m1(t4_m1, P[4], g2_m1);
or  OR_G4_m1(g4_m1, G[4], t4_m1);

and AND_P3_m1(p3_m1, P[3], p2_m1);
and AND_T3_m1(t3_m1, P[3], g2_m1);
or  OR_G3_m1(g3_m1, G[3], t3_m1);

// Fourth prefix level
and AND_P14_m1(p14_m1, p14_7, p6_m1);
and AND_T14_m1(t14_m1, p14_7, g6_m1);
or  OR_G14_m1(g14_m1, g14_7, t14_m1);

and AND_P13_m1(p13_m1, p13_7, p6_m1);
and AND_T13_m1(t13_m1, p13_7, g6_m1);
or  OR_G13_m1(g13_m1, g13_7, t13_m1);

and AND_P12_m1(p12_m1, p12_7, p6_m1);
and AND_T12_m1(t12_m1, p12_7, g6_m1);
or  OR_G12_m1(g12_m1, g12_7, t12_m1);

and AND_P11_m1(p11_m1, p11_7, p6_m1);
and AND_T11_m1(t11_m1, p11_7, g6_m1);
or  OR_G11_m1(g11_m1, g11_7, t11_m1);

and AND_P10_m1(p10_m1, p10_7, p6_m1);
and AND_T10_m1(t10_m1, p10_7, g6_m1);
or  OR_G10_m1(g10_m1, g10_7, t10_m1);

and AND_P9_m1(p9_m1, p9_7, p6_m1);
and AND_T9_m1(t9_m1, p9_7, g6_m1);
or  OR_G9_m1(g9_m1, g9_7, t9_m1);

and AND_P8_m1(p8_m1, p8_7, p6_m1);
and AND_T8_m1(t8_m1, p8_7, g6_m1);
or  OR_G8_m1(g8_m1, g8_7, t8_m1);

and AND_P7_m1(p7_m1, P[7], p6_m1);
and AND_T7_m1(t7_m1, P[7], g6_m1);
or  OR_G7_m1(g7_m1, G[7], t7_m1);

// Post-computation block
xor XOR_S0(S[0], P[0], Cin);

xor XOR_S1(S[1], P[1], g0_m1);
xor XOR_S2(S[2], P[2], g1_m1);
xor XOR_S3(S[3], P[3], g2_m1);
xor XOR_S4(S[4], P[4], g3_m1);
xor XOR_S5(S[5], P[5], g4_m1);
xor XOR_S6(S[6], P[6], g5_m1);
xor XOR_S7(S[7], P[7], g6_m1);

xor XOR_S8(S[8], P[8], g7_m1);
xor XOR_S9(S[9], P[9], g8_m1);
xor XOR_S10(S[10], P[10], g9_m1);
xor XOR_S11(S[11], P[11], g10_m1);
xor XOR_S12(S[12], P[12], g11_m1);
xor XOR_S13(S[13], P[13], g12_m1);
xor XOR_S14(S[14], P[14], g13_m1);
xor XOR_S15(S[15], P[15], g14_m1);

// Carry out
wire tCout;

and AND_COUT(tCout, P[15], g14_m1);
or  OR_COUT(Cout, G[15], tCout);

endmodule
